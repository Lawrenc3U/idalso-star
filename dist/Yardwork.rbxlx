      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--!strict
-- Set IDs to your own published products. Zero IDs hide purchase buttons.
local C: any = {}
C.Audio = {Break=0, Sell=0, Rank=0, Music=0} -- upload assets/audio/*.wav and set IDs
C.DataStore = "YardworkProfiles_v1"
C.Prototype = true -- false enables all 26 ranks and prestige
C.StudioMemory = true -- Studio-only, never used by published servers
C.PlayerCap = 8 -- set the same cap in experience settings; profile on devices before raising
C.RankCount = if C.Prototype then 3 else 26
C.ResetSeconds = 300
C.Grid = 6
C.Depth = 3
C.BlockSize = 4
C.Reach = 22
C.Ores = {
 {Name="Chalk", Weight=70, Value=1, Health=1, Color=Color3.fromRGB(220,224,209)},
 {Name="Copper", Weight=25, Value=3, Health=2, Color=Color3.fromRGB(223,139,82)},
 {Name="Glowstone", Weight=5, Value=8, Health=3, Color=Color3.fromRGB(79,220,179)},
}
C.Picks = {
 {Name="Yard Pick", Cost=0, Damage=1, Interval=0.45},
 {Name="Trusty Pick", Cost=180, Damage=2, Interval=0.38},
 {Name="Workshop Pick", Cost=800, Damage=3, Interval=0.30},
 {Name="Foreman Pick", Cost=4500, Damage=5, Interval=0.24},
}
C.Bags = {30,60,120,240,480}
C.BagCosts = {0,150,650,2500,10000}
C.Passes = {Money=0, Tokens=0, Auto=0, Backpack=0, VIP=0}
-- IDs must be unique, nonzero, and belong to this experience before enabling.
C.Products = {
 {Id=0, Name="Starter Pack", Kind="Starter", Amount=500, Robux=49},
 {Id=0, Name="Pocket Money", Kind="Money", Amount=2000, Robux=29},
 {Id=0, Name="Workshop Fund", Kind="Money", Amount=12000, Robux=99},
 {Id=0, Name="2x Money: 15 min", Kind="Boost", Amount=900, Robux=29},
 {Id=0, Name="2x Money: 30 min", Kind="Boost", Amount=1800, Robux=49},
 {Id=0, Name="2x Money: 60 min", Kind="Boost", Amount=3600, Robux=79},
 {Id=0, Name="Mine Reset Credit", Kind="Reset", Amount=1, Robux=19},
}
C.Codes = {WELCOME={Money=100, Tokens=0}} -- rotate/expire on server before campaigns
C.Event = {Name="Workshop Weekend", Start=0, Finish=0, Bonus=1} -- UTC timestamps; inactive by default
C.TokenPrices = {Fortune=5, Chain=8, Burst=12, Capacity=5, Skin=10, Pet=15}
function C.rankCost(rank: number): number return if rank==1 then 900 else math.floor(1800 * 1.34 ^ (rank-2)) end
function C.rankMultiplier(rank: number): number return 1 + (rank-1)*0.08 end
function C.prestigeCost(prestiges: number): number return math.floor(120000*(1+prestiges*0.25)) end
function C.oreValue(ore: number, tier: number): number return math.floor(C.Ores[ore].Value * 1.2^(tier-1)) end
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">HUDLayout</string>
          <ProtectedString name="Source">--!strict
-- Pure layout arithmetic so small-screen spacing can be checked without Roblox.
export type Rect = {X: number, Y: number, W: number, H: number}
local L = {}
function L.compute(width: number,height: number): any
 local w=math.max(width,320); local h=math.max(height,320)
 local phone=w&lt;600; local landscape=h&lt;500
 local margin=if phone then 12 else 20
 local function rect(x: number,y: number,rw: number,rh: number): Rect return {X=x,Y=y,W=rw,H=rh} end
 local walletW=if phone then (if w&lt;350 then 150 else 174) else 218
 local rankW=if phone then (if w&lt;350 then 134 else 146) else 234
 local topH=if landscape then 54 else 66
 local navSize=if landscape then 48 else 56
 local navGap=8
 local navW=if landscape then navSize*3+navGap*2 else (if phone then 60 else 132)
 local navH=if landscape then navSize else navSize*3+navGap*2
 local goalW=if landscape then math.min(310,w-walletW-rankW-4*margin) else math.min(300,w-2*margin)
 local goalX=if landscape then (w-goalW)/2 else margin
 local goalY=if landscape then margin else margin+topH+10
 local targetW=if w&lt;350 then 140 else 170
 local bagW=if phone then w-2*margin else math.min(400,w-360)
 local bagY=if phone then h-216 else h-84
 local navY=if landscape then 88 else margin+topH+86
 return {
  Phone=phone,Landscape=landscape,Margin=margin,
  Target=rect((w-targetW)/2,h/2+24,targetW,43),
  Wallet=rect(margin,margin,walletW,topH),Rank=rect(w-margin-rankW,margin,rankW,topH),
  Goal=rect(goalX,goalY,math.max(0,goalW),if landscape then 54 else 62),
  Nav=rect(if landscape then (w-navW)/2 else margin,navY,navW,navH),NavSize=navSize,
  Bag=rect((w-bagW)/2,bagY,bagW,68),
  Mine=rect(w-margin-76,if phone then math.min(h*0.49,bagY-88) else (if landscape then math.min(156,h-228) else h-236),76,76),
  Modal=rect((w-math.min(650,w-24))/2,(h-math.min(570,h-24))/2,math.min(650,w-24),math.min(570,h-24)),
 }
end
return L
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">Types</string>
          <ProtectedString name="Source">--!strict
export type Profile = {
 Version: number, Money: number, Tokens: number, Rank: number, Prestiges: number,
 Pick: number, Bag: number, Ore: {[string]: number}, Enchants: {[string]: number},
 BoostUntil: number, ResetCredits: number, ResetPending: number, StarterOwned: boolean, Codes: {[string]: boolean},
 Daily: number, Streak: number, Receipts: {[string]: boolean}, Milestones: {[string]: boolean},
 TotalEarned: number, LastDay: number, FirstDay: number, Settings: {[string]: boolean},
}
return {}
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX8">
      <Properties>
        <string name="Name">Bootstrap</string>
        <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local C=require(RS.Shared.Config)
local services=script.Parent.Services
local Data=require(services.DataService)
local E=require(services.EconomyService)
local A=require(services.AnalyticsService)
local B=require(services.BackpackService)
local R=require(services.RankService)
local P=require(services.PrestigeService)
local S=require(services.ShopService)
local T=require(services.RetentionService)
local Mine=require(services.MineService)
local Art=require(services.WorldArt)
local Money=require(services.MonetizationService)
local Leaders=require(services.LeaderboardService)
local remotes=Instance.new("Folder"); remotes.Name="YardworkRemotes"; remotes.Parent=RS
local action=Instance.new("RemoteEvent"); action.Name="Action"; action.Parent=remotes
local state=Instance.new("RemoteEvent"); state.Name="State"; state.Parent=remotes
local notice=Instance.new("RemoteEvent"); notice.Name="Notice"; notice.Parent=remotes
A.new(Data); B.new(Data,E,A); R.new(Data,A); P.new(Data,E,A); S.new(Data,A); T.new(Data,A); Mine.new(Data,B,A); Money.new(Data,E,A)
Mine.build(); Data.start(); Leaders.start(Data)
local buckets: {[Player]: any}={}
local working: {[Player]: boolean}={}
local function push(player: Player)
 local p=Data.read(player); if not p then return end
 local resets={}; for tier,m in pairs(Mine.Mines) do resets[tier]=math.max(0,m.Next-os.time()) end
 -- Explicit projection; receipt IDs, redeemed codes, lock tokens remain server-only.
 state:FireClient(player,{Money=p.Money,Tokens=p.Tokens,Rank=p.Rank,Prestiges=p.Prestiges,
  Pick=p.Pick,Bag=p.Bag,Count=B.count(p),Capacity=B.capacity(player,p),Enchants=p.Enchants,
  BoostUntil=p.BoostUntil,ResetCredits=p.ResetCredits,Streak=p.Streak,Daily=p.Daily,
  NearSell=Mine.nearSell(player),MineTier=Mine.Current[player] or 1,Passes=E.Passes[player] or {},Settings=p.Settings,Resets=resets,Leaders=Leaders.Cache})
 for _,container in {player.Character,player:FindFirstChild("Backpack")} do
  if container then for _,child in container:GetChildren() do if child:IsA("Tool") and child:GetAttribute("YardworkPick") then Art.stylePickaxe(child,p.Pick,p.Enchants.Skin&gt;0) end end end
 end
 local stats=player:FindFirstChild("leaderstats")
 if stats then
  local money=stats:FindFirstChild("Money") :: NumberValue; money.Value=p.Money
  local rank=stats:FindFirstChild("Rank") :: IntValue; rank.Value=p.Rank
  local prestige=stats:FindFirstChild("Prestiges") :: IntValue; prestige.Value=p.Prestiges
 end
end
Mine.PromptSell=function(player: Player)
 if working[player] or not Mine.nearSell(player) then return end
 working[player]=true
 local ok,sold=pcall(B.sell,player)
 working[player]=nil
 if ok then push(player); if not sold then notice:FireClient(player,"Your backpack is empty. Mine a few blocks first.") end end
end
local function joined(player: Player)
 if not Data.load(player) then player:Kick("Profile busy or unavailable. Please try again shortly; no progress was overwritten."); return end
 if not player.Parent then Data.save(player,true); return end
 if Data.Closing then Data.save(player,true); player:Kick("Server closing. Please rejoin."); return end
 Money.refresh(player); T.join(player)
 local pending=Data.read(player)
 if pending and pending.ResetPending&gt;0 and Mine.Mines[pending.ResetPending] then
  Mine.Mines[pending.ResetPending].Next=math.min(Mine.Mines[pending.ResetPending].Next,os.time()+30)
 end
 local stats=Instance.new("Folder"); stats.Name="leaderstats"; stats.Parent=player
 for _,name in {"Money","Rank","Prestiges"} do
  local v=Instance.new(if name=="Money" then "NumberValue" else "IntValue"); v.Name=name; v.Parent=stats
 end
 local function characterReady(character: Model)
  local root=character:WaitForChild("HumanoidRootPart",10)
  if root then character:PivotTo(CFrame.new(Mine.safe(1))); Mine.Current[player]=1 end
  local humanoid=character:FindFirstChildOfClass("Humanoid")
  if humanoid and E.pass(player,"VIP") then humanoid.DisplayName="[VIP] "..player.DisplayName end
  local tool=Instance.new("Tool"); tool.Name="Yard Pick"; tool.RequiresHandle=true; tool.CanBeDropped=false
  tool:SetAttribute("YardworkPick",true); Art.pickaxe(tool)
  local backpack=player:WaitForChild("Backpack",10)
  if backpack then
   tool.Parent=backpack
   local profile=Data.read(player)
   if profile then Art.stylePickaxe(tool,profile.Pick,profile.Enchants.Skin&gt;0) end
   if humanoid then humanoid:EquipTool(tool) end
  end
 end
 player.CharacterAdded:Connect(characterReady)
 if player.Character then task.spawn(characterReady,player.Character) end
 push(player)
end
Players.PlayerAdded:Connect(joined)
for _,player in Players:GetPlayers() do task.spawn(joined,player) end
Players.PlayerRemoving:Connect(function(player: Player)
 Data.save(player,true); E.Passes[player]=nil; buckets[player]=nil; working[player]=nil; Mine.Last[player]=nil; Mine.Visits[player]=nil; Mine.Current[player]=nil
end)
action.OnServerEvent:Connect(function(player: Player,verb: any,arg: any)
 if type(verb)~="string" or #verb&gt;20 then return end
 local now=os.clock(); local bucket=buckets[player] or {Tokens=16,At=now}
 bucket.Tokens=math.min(16,bucket.Tokens+(now-bucket.At)*8); bucket.At=now; buckets[player]=bucket
 if bucket.Tokens&lt;1 or working[player] then return end
 bucket.Tokens-=1
 if not Data.read(player) then return end
 working[player]=true
 local ok,err=pcall(function()
  local success=false
  if verb=="Sync" then push(player); return
  elseif verb=="Mine" and typeof(arg)=="Instance" then success=Mine.hit(player,arg)
  elseif verb=="Sell" and Mine.nearSell(player) then success=B.sell(player)
  elseif verb=="VisitSell" then success=Mine.goSell(player)
  elseif verb=="Rank" then success=R.buy(player)
  elseif verb=="Prestige" and arg=="CONFIRM_RESET" then success=P.buy(player); if success then Mine.teleport(player,1) end
  elseif verb=="Shop" and type(arg)=="string" and #arg&lt;=20 then success=S.buy(player,arg)
  elseif verb=="VIP" and E.pass(player,"VIP") and player.Character then
   player.Character:PivotTo(CFrame.new(-50,5,25)); success=true
  elseif verb=="Visit" and type(arg)=="number" and arg==arg and math.abs(arg)&lt;100 then success=Mine.teleport(player,arg)
  elseif verb=="Daily" then success=T.daily(player)
  elseif verb=="Code" and type(arg)=="string" and #arg&lt;=32 then success=T.code(player,string.upper(arg))
  elseif verb=="Reset" then
   local p=Data.read(player); local tier=Mine.Current[player] or 1
   local m=Mine.Mines[tier]
   if not m.Resetting and m.Next-os.time()&lt;C.ResetSeconds-60 then
    -- Queue intent persists before the credit is consumed; world operation cannot grant currency.
    success=Data.transaction(player,function(d: any)
     if d.ResetCredits&lt;=0 then return false end
     if d.ResetPending&gt;0 then return false end
     d.ResetCredits-=1; d.ResetPending=tier; return true
    end,true)
    if success then m.Next=math.min(m.Next,os.time()+30); notice:FireAllClients("Extra mine reset in 30 seconds. Move to the rim!") end
   end
  elseif verb=="Setting" and type(arg)=="string" and (arg=="Music" or arg=="Effects" or arg=="Motion") then
   success=Data.transaction(player,function(p: any) p.Settings[arg]=not p.Settings[arg]; return true end)
  end
  if verb~="Mine" then
   local messages={Shop="Upgrade equipped.",Rank="New rank unlocked!",Visit="Back at the quarry.",VisitSell="Ready to sell your haul.",Setting="Preference saved.",Daily="Daily reward claimed.",Code="Code redeemed.",Reset="Safe reset scheduled.",Prestige="A fresh start!",VIP="Welcome to the quiet corner."}
   if success then
    if messages[verb] then notice:FireClient(player,messages[verb]) end
   else
    notice:FireClient(player,if verb=="Sell" then "Stand near the green sell counter with ore in your bag." else "Not available yet. Check the requirement shown in the menu.")
   end
  end
  push(player)
 end)
 working[player]=nil
 if not ok then warn("Action failed:",tostring(err)); notice:FireClient(player,"Action could not complete. Try again.") end
end)
task.spawn(function()
 while true do task.wait(2); for _,player in Players:GetPlayers() do push(player) end end
end)
game:BindToClose(function()
 Data.Closing=true
 local count=0
 for player in pairs(Data.Sessions) do count+=1; task.spawn(function() Data.save(player,true); count-=1 end) end
 local deadline=os.clock()+25; while count&gt;0 and os.clock()&lt;deadline do task.wait(0.1) end
end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX9">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">AnalyticsService</string>
          <ProtectedString name="Source">--!strict
local Platform = game:GetService("AnalyticsService")
local Run = game:GetService("RunService")
local A: any = {}
function A.new(data: any)
 A.Data=data
end
function A.once(player: Player, name: string)
 local fresh=false
 A.Data.transaction(player,function(p: any)
  if not p.Milestones[name] then p.Milestones[name]=true; fresh=true end
  return true
 end)
 if fresh then
  if Run:IsStudio() then print("Yardwork milestone:",name) else
   pcall(function() Platform:LogCustomEvent(player,name,1) end)
  end
 end
end
return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">BackpackService</string>
          <ProtectedString name="Source">--!strict
local C=require(game.ReplicatedStorage.Shared.Config)
local B: any = {}
function B.new(data: any,economy: any,analytics: any) B.Data=data; B.E=economy; B.A=analytics end
function B.count(p: any): number
 local n=0; for _,v in pairs(p.Ore) do n+=v end; return n
end
function B.capacity(player: Player,p: any): number
 return math.floor((C.Bags[p.Bag]+p.Enchants.Capacity*15)*(if B.E.pass(player,"Backpack") then 1.5 else 1))
end
function B.sell(player: Player): boolean
 local p=B.Data.read(player); if not p then return false end
 -- Friend calls may yield, so calculate before entering the non-yielding mutation.
 local multiplier=B.E.multiplier(player,p)
 local sold=B.Data.transaction(player,function(d: any)
  local value=0
  for key,n in pairs(d.Ore) do
   local tier,ore=string.match(key,"^(%d+):(%d+)$")
   if tier and ore then value+=C.oreValue(tonumber(ore),tonumber(tier))*n end
  end
  if value&lt;=0 then return false end
  local reward=math.floor(value*multiplier)
  d.Money+=reward; d.TotalEarned+=reward; d.Ore={}; return true
 end)
 if sold then B.A.once(player,"FirstSell") end
 return sold
end
return B
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source">--!strict
-- All profile mutations use transaction(). No mutable profiles escape this module.
local DSS = game:GetService("DataStoreService")
local Http = game:GetService("HttpService")
local Run = game:GetService("RunService")
local C = require(game.ReplicatedStorage.Shared.Config)
local Data: any = {Sessions={}, Closing=false}
-- Unpublished Studio places must never open a real DataStore in memory mode.
-- Open lazily inside update's pcall so access failures follow the safe load path.
local useMemory = Run:IsStudio() and C.StudioMemory
local store: any = nil
local memory: {[string]: any} = {}
local function copy(x: any): any
 if type(x) ~= "table" then return x end
 local r = {}; for k,v in pairs(x) do r[k]=copy(v) end; return r
end
local function defaults(): any
 return {Version=1, Money=0, Tokens=0, Rank=1, Prestiges=0, Pick=1, Bag=1, Ore={},
 Enchants={Fortune=0,Chain=0,Burst=0,Capacity=0,Skin=0,Pet=0}, BoostUntil=0,
 ResetCredits=0, ResetPending=0, StarterOwned=false, Codes={}, Daily=-1, Streak=0, Receipts={},
 Milestones={}, TotalEarned=0, LastDay=-1, FirstDay=-1,
 Settings={Music=true,Effects=true,Motion=true}}
end
local function update(key: string, fn: (any)-&gt;any): (boolean, any)
 for attempt=1,4 do
  local ok,res=pcall(function()
   if useMemory then
    local nextValue=fn(copy(memory[key])); if nextValue then memory[key]=copy(nextValue) end
    return copy(memory[key])
   end
   if not store then store = DSS:GetDataStore(C.DataStore) end
   return store:UpdateAsync(key,fn)
  end)
  if ok then return true,res end
  warn("Profile store retry",attempt) -- no private data in output
  task.wait(math.min(2^(attempt-1),8))
 end
 return false,nil
end
function Data.load(player: Player): boolean
 if Data.Closing then return false end
 local key="p_"..player.UserId
 local token=Http:GenerateGUID(false)
 local ok,record=update(key,function(old: any)
  if old and old.Data and old.Data.Version &gt; 1 then return nil end
  if old and old.Lock and old.Lock.Expires &gt; os.time() then return nil end
  local d=if old and old.Data then old.Data else defaults()
  -- v1 migration: fill newly introduced fields; unknown future versions are refused.
  for k,v in pairs(defaults()) do if d[k]==nil then d[k]=v end end
  return {Data=d,Lock={Token=token,Expires=os.time()+180}}
 end)
 if not ok or not record or not record.Lock or record.Lock.Token~=token then return false end
 Data.Sessions[player]={Key=key,Token=token,Profile=record.Data,Busy=false,Lost=false,Lease=record.Lock.Expires}
 return true
end
local function acquire(s: any): boolean
 while s.Busy do task.wait() end
 if s.Lost then return false end
 s.Busy=true; return true
end
local function persist(s: any, p: any, release: boolean): boolean
 local revision=Http:GenerateGUID(false)
 local ok,record=update(s.Key,function(old: any)
  if not old or not old.Lock or old.Lock.Token~=s.Token or old.Lock.Expires&lt;=os.time() then return nil end
  return {Data=p,Revision=revision,Lock=if release then nil else {Token=s.Token,Expires=os.time()+180}}
 end)
 local valid=ok and record and record.Revision==revision and (if release then record.Lock==nil else record.Lock and record.Lock.Token==s.Token)
 if valid and not release then s.Lease=record.Lock.Expires end
 if not valid then s.Lost=true end
 return valid==true
end
function Data.read(player: Player): any
 local s=Data.Sessions[player]
 if not s or s.Lost or os.time() &gt;= s.Lease-10 then return nil end
 return copy(s.Profile)
end
function Data.transaction(player: Player, fn: (any)-&gt;boolean, durable: boolean?): boolean
 local s=Data.Sessions[player]
 if not s or s.Busy or not acquire(s) then return false end
 if os.time()&gt;=s.Lease-10 then s.Busy=false; return false end
 local candidate=copy(s.Profile)
 local ok,accept=pcall(fn,candidate)
 if not ok then warn("Profile transaction failed") end
 local success=ok and accept==true
 if success and durable then success=persist(s,candidate,false) end
 if success then s.Profile=candidate end
 s.Busy=false
 return success
end
function Data.save(player: Player, release: boolean?): boolean
 local s=Data.Sessions[player]; if not s or not acquire(s) then return false end
 local ok=persist(s,s.Profile,release==true)
 s.Busy=false
 if release or not ok then Data.Sessions[player]=nil end
 return ok
end
function Data.start()
 task.spawn(function()
  while not Data.Closing do
   task.wait(45)
   for player in pairs(Data.Sessions) do
    if not Data.save(player,false) then player:Kick("Saving unavailable. Please rejoin to protect your progress.") end
   end
  end
 end)
end
return Data
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">EconomyService</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local C=require(game.ReplicatedStorage.Shared.Config)
local E: any = {Passes={}}
function E.pass(player: Player, name: string): boolean
 return E.Passes[player] and E.Passes[player][name]==true or false
end
function E.multiplier(player: Player, p: any): number
 local friends=0
 for _,other in Players:GetPlayers() do
  if other~=player then
   local ok,isFriend=pcall(function() return player:IsFriendsWith(other.UserId) end)
   if ok and isFriend then friends+=1 end
  end
 end
 local event=if os.time()&gt;=C.Event.Start and os.time()&lt;C.Event.Finish then C.Event.Bonus else 0
 local social=math.min(2.15,1+math.min(friends,3)*0.05+event)
 return C.rankMultiplier(p.Rank)*math.min(5,1+p.Prestiges*0.2)
  *(if E.pass(player,"Money") then 2 else 1)*(if p.BoostUntil&gt;os.time() then 2 else 1)*social
end
return E
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <ProtectedString name="Source">--!strict
local DSS=game:GetService("DataStoreService")
local Run=game:GetService("RunService")
local C=require(game.ReplicatedStorage.Shared.Config)
local L: any = {Cache={}}
function L.start(data: any)
 if Run:IsStudio() or C.Prototype then return end
 task.spawn(function()
  while true do
   task.wait(120)
   for _,metric in {"Money","Rank","Prestiges"} do
    local store=DSS:GetOrderedDataStore("Yardwork_"..metric.."_v1")
    for player in pairs(data.Sessions) do
     local p=data.read(player)
     if p then pcall(function() store:SetAsync(tostring(player.UserId),math.floor(p[metric])) end); task.wait(0.3) end
    end
    local ok,pages=pcall(function() return store:GetSortedAsync(false,10) end)
    if ok then L.Cache[metric]=pages:GetCurrentPage() end
   end
  end
 end)
end
return L
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15">
        <Properties>
          <string name="Name">MineService</string>
          <ProtectedString name="Source">--!strict
local Tags=game:GetService("CollectionService")
local Players=game:GetService("Players")
local C=require(game.ReplicatedStorage.Shared.Config)
local Art=require(script.Parent.WorldArt)
local M: any = {Mines={},Blocks={},Last={},Visits={},Current={},Random=Random.new()}
local function part(name: string,size: Vector3,position: Vector3,color: Color3,parent: Instance): Part
 local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=position
 p.Color=color; p.Anchored=true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=parent; return p
end
function M.new(data: any,bag: any,analytics: any) M.Data=data; M.Bag=bag; M.A=analytics end
function M.safe(tier: number): Vector3 return Vector3.new((tier-1)*90,5,24) end
function M.teleport(player: Player,tier: number): boolean
 local p=M.Data.read(player)
 if not p or tier%1~=0 or tier&lt;1 or tier&gt;p.Rank or not M.Mines[tier] then return false end
 local character=player.Character; if not character then return false end
 character:PivotTo(CFrame.new(M.safe(tier)))
 M.Visits[player]=os.clock(); M.Current[player]=tier; return true
end
function M.nearSell(player: Player): boolean
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not root or not root:IsA("BasePart") then return false end
 local p=M.Data.read(player); if not p then return false end
 for tier,mine in pairs(M.Mines) do
  if tier&lt;=p.Rank and (root.Position-mine.Sell.Position).Magnitude&lt;=16 then return true end
 end
 return false
end
function M.reset(tier: number)
 local mine=M.Mines[tier]; if mine.Resetting then return end
 mine.Resetting=true; mine.Generation+=1
 for _,player in Players:GetPlayers() do
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if root and root:IsA("BasePart") and math.abs(root.Position.X-mine.X)&lt;38 and math.abs(root.Position.Z)&lt;18 then
   if player.Character then player.Character:PivotTo(CFrame.new(M.safe(tier))) end
  end
 end
 for _,block in mine.Folder:GetChildren() do M.Blocks[block]=nil; block:Destroy() end
 for y=0,C.Depth-1 do
  for x=0,C.Grid-1 do
   for z=0,C.Grid-1 do
    local roll=M.Random:NextInteger(1,100); local index=1
    for i,ore in C.Ores do roll-=ore.Weight; if roll&lt;=0 then index=i; break end end
    local ore=C.Ores[index]
    local b=part(ore.Name,Vector3.one*C.BlockSize,Vector3.new(mine.X+(x-2.5)*4,-2-y*4,(z-2.5)*4),ore.Color,mine.Folder)
    Art.ore(b,index,tier)
    b:SetAttribute("Health",ore.Health); b:SetAttribute("MaxHealth",ore.Health); b:SetAttribute("Tier",tier)
    Tags:AddTag(b,"MineBlock")
    M.Blocks[b]={Tier=tier,Ore=index,Health=ore.Health,Generation=mine.Generation}
   end
  end
  task.wait() -- bounded reset batches
 end
 mine.Next=os.time()+C.ResetSeconds; mine.Resetting=false
 -- Pending reset intents survive crashes; clear only after a completed rebuild.
 for player in pairs(M.Data.Sessions) do
  local d=M.Data.read(player)
  if d and d.ResetPending==tier then
   M.Data.transaction(player,function(p: any) p.ResetPending=0; return true end,true)
  end
 end
end
function M.goSell(player: Player): boolean
 local p=M.Data.read(player); if not p then return false end
 local tier=M.Current[player] or 1
 if tier&gt;p.Rank then return false end
 local mine=M.Mines[tier]; local character=player.Character
 local human=character and character:FindFirstChildOfClass("Humanoid")
 if not mine or not character or not human or human.Health&lt;=0 then return false end
 local destination=mine.Sell.Position+Vector3.new(0,4,-1)
 character:PivotTo(CFrame.lookAt(destination,destination+Vector3.new(0,0,1)))
 M.Current[player]=tier; return true
end
function M.build()
 local world=Instance.new("Folder"); world.Name="YardworkWorld"; world.Parent=workspace
 Art.lighting()
 local count=if C.Prototype then 1 else 26
 for tier=1,count do
  local x=(tier-1)*90
  local yard=Art.yard(world,x,tier)
  yard.Prompt.Triggered:Connect(function(player: Player)
   if M.PromptSell then M.PromptSell(player) end
  end)
  local folder=Instance.new("Folder"); folder.Name="Blocks"..tier; folder.Parent=world
  M.Mines[tier]={X=x,Folder=folder,Sell=yard.Sell,Next=0,Resetting=false,Generation=0}
  M.reset(tier)
 end
 task.spawn(function()
  while true do
   task.wait(1)
   for tier,mine in pairs(M.Mines) do
    if os.time()&gt;=mine.Next and not mine.Resetting then task.spawn(M.reset,tier) end
   end
  end
 end)
end
function M.hit(player: Player,block: Instance): boolean
 local info=M.Blocks[block]; if not info or not block:IsA("BasePart") then return false end
 local mine=M.Mines[info.Tier]; if mine.Resetting or info.Generation~=mine.Generation then return false end
 local p=M.Data.read(player); if not p or info.Tier&gt;p.Rank then return false end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local head=player.Character and player.Character:FindFirstChild("Head")
 local human=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
 if not root or not root:IsA("BasePart") or not head or not head:IsA("BasePart") or not human or human.Health&lt;=0 then return false end
 if (root.Position-block.Position).Magnitude&gt;C.Reach then return false end
 local pick=C.Picks[p.Pick]
 if os.clock()-(M.Last[player] or 0)&lt;pick.Interval then return false end
 local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character :: Instance}
 local ray=workspace:Raycast(head.Position,(block.Position-head.Position),params)
 if ray and ray.Instance~=block then return false end
 if M.Bag.count(p)&gt;=M.Bag.capacity(player,p) then return false end
 M.Last[player]=os.clock()
 info.Health-=pick.Damage; block:SetAttribute("Health",math.max(0,info.Health))
 if info.Health&gt;0 then return true end
 -- No yields between reward transaction and removing blocks: a break can resolve only once.
 local targets={block}
 local limit=1+p.Enchants.Chain+(if p.Enchants.Burst&gt;0 then 1+p.Enchants.Burst else 0)
 if limit&gt;1 then
  for candidate,entry in pairs(M.Blocks) do
   if #targets&gt;=math.min(12,limit) then break end
   if candidate~=block and entry.Tier==info.Tier and (candidate.Position-block.Position).Magnitude&lt;=7 then table.insert(targets,candidate) end
  end
 end
 local removed: {Instance}={}
 local accepted=M.Data.transaction(player,function(d: any)
  local room=M.Bag.capacity(player,d)-M.Bag.count(d)
  for _,target in targets do
   local entry=M.Blocks[target]
   if room&lt;=0 then break end
   if entry then
    local amount=math.min(room,1+(if M.Random:NextNumber()&lt;d.Enchants.Fortune*0.08 then 1 else 0))
    local key=entry.Tier..":"..entry.Ore
    d.Ore[key]=(d.Ore[key] or 0)+amount; room-=amount; table.insert(removed,target)
   end
  end
  return #removed&gt;0
 end)
 if accepted then
  for _,target in removed do M.Blocks[target]=nil; target:Destroy() end
  M.A.once(player,"FirstMine")
 else info.Health=1; block:SetAttribute("Health",1) end
 return accepted
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">MonetizationService</string>
          <ProtectedString name="Source">--!strict
local Market=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local C=require(game.ReplicatedStorage.Shared.Config)
local M: any = {Products={}}
function M.new(data: any,economy: any,analytics: any)
 M.Data=data; M.E=economy; M.A=analytics
 for _,product in C.Products do
  if product.Id&gt;0 then assert(not M.Products[product.Id],"Duplicate product ID"); M.Products[product.Id]=product end
 end
 Market.ProcessReceipt=function(receipt: any)
  local player=Players:GetPlayerByUserId(receipt.PlayerId)
  local product=M.Products[receipt.ProductId]
  if not player or not product then return Enum.ProductPurchaseDecision.NotProcessedYet end
  local id=tostring(receipt.PurchaseId)
  local ok=data.transaction(player,function(p: any)
   if p.Receipts[id] then return true end
   -- Never prune IDs without an archival design: delayed replays must remain idempotent.
   if product.Kind=="Money" then p.Money+=product.Amount
   elseif product.Kind=="Starter" then
    -- Repeat purchases still fulfil the advertised money grant; skin already owned is harmless.
    p.Money+=product.Amount; p.StarterOwned=true; p.Enchants.Skin=1
   elseif product.Kind=="Boost" then p.BoostUntil=math.max(os.time(),p.BoostUntil)+product.Amount
   elseif product.Kind=="Reset" then p.ResetCredits+=product.Amount
   else return false end
   p.Receipts[id]=true; return true
  end,true)
  if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
  analytics.once(player,"FirstPurchase")
  return Enum.ProductPurchaseDecision.PurchaseGranted
 end
 Market.PromptGamePassPurchaseFinished:Connect(function(player: Player,_id: number,bought: boolean)
  if bought then M.refresh(player) end
 end)
end
function M.refresh(player: Player)
 local owned={}
 for name,id in pairs(C.Passes) do
  if id&gt;0 then
   local ok,res=pcall(function() return Market:UserOwnsGamePassAsync(player.UserId,id) end)
   if ok and res then owned[name]=true end
  end
 end
 M.E.Passes[player]=owned
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">PrestigeService</string>
          <ProtectedString name="Source">--!strict
local C=require(game.ReplicatedStorage.Shared.Config)
local P: any = {}
function P.new(data: any,economy: any,analytics: any) P.Data=data; P.E=economy; P.A=analytics end
function P.buy(player: Player): boolean
 if C.Prototype then return false end
 local ok=P.Data.transaction(player,function(p: any)
  if p.Rank&lt;26 or p.Money&lt;C.prestigeCost(p.Prestiges) then return false end
  p.Prestiges+=1; p.Tokens+=10*(if P.E.pass(player,"Tokens") then 2 else 1)
  p.Money=0; p.Rank=1; p.Pick=1; p.Bag=1; p.Ore={}; return true
 end,true)
 if ok then P.A.once(player,"FirstPrestige") end; return ok
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18">
        <Properties>
          <string name="Name">RankService</string>
          <ProtectedString name="Source">--!strict
local C=require(game.ReplicatedStorage.Shared.Config)
local R: any = {}
function R.new(data: any,analytics: any) R.Data=data; R.A=analytics end
function R.buy(player: Player): boolean
 local ok=R.Data.transaction(player,function(p: any)
  if p.Rank&gt;=C.RankCount then return false end
  local cost=C.rankCost(p.Rank); if p.Money&lt;cost then return false end
  p.Money-=cost; p.Rank+=1; return true
 end,true)
 if ok then R.A.once(player,"FirstRankUp") end; return ok
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX19">
        <Properties>
          <string name="Name">RetentionService</string>
          <ProtectedString name="Source">--!strict
local C=require(game.ReplicatedStorage.Shared.Config)
local R: any = {}
function R.new(data: any,analytics: any) R.Data=data; R.A=analytics end
function R.join(player: Player)
 local day=math.floor(os.time()/86400); local dayOne=false
 R.Data.transaction(player,function(p: any)
  if p.FirstDay&lt;0 then p.FirstDay=day end
  dayOne=day==p.FirstDay+1
  p.LastDay=day; return true
 end)
 if dayOne then R.A.once(player,"Day1Return") end
end
function R.daily(player: Player): boolean
 if C.Prototype then return false end
 return R.Data.transaction(player,function(p: any)
  local day=math.floor(os.time()/86400)
  if p.Daily&gt;=day then return false end
  p.Streak=if p.Daily==day-1 then math.min(7,p.Streak+1) else 1
  p.Daily=day; p.Money+=100*p.Streak; return true
 end,true)
end
function R.code(player: Player,code: string): boolean
 if C.Prototype then return false end
 local reward=C.Codes[code]; if not reward then return false end
 return R.Data.transaction(player,function(p: any)
  if p.Codes[code] then return false end
  p.Codes[code]=true; p.Money+=reward.Money; p.Tokens+=reward.Tokens; return true
 end,true)
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX20">
        <Properties>
          <string name="Name">ShopService</string>
          <ProtectedString name="Source">--!strict
local C=require(game.ReplicatedStorage.Shared.Config)
local S: any = {}
function S.new(data: any,analytics: any) S.Data=data; S.A=analytics end
function S.buy(player: Player,item: string): boolean
 local ok=S.Data.transaction(player,function(p: any)
  if item=="Pick" then
   local nextTier=p.Pick+1; local pick=C.Picks[nextTier]
   if not pick or (C.Prototype and nextTier&gt;3) or p.Money&lt;pick.Cost then return false end
   p.Money-=pick.Cost; p.Pick=nextTier
  elseif item=="Bag" then
   local tier=p.Bag+1; local cost=C.BagCosts[tier]
   if not cost or (C.Prototype and tier&gt;3) or p.Money&lt;cost then return false end
   p.Money-=cost; p.Bag=tier
  elseif C.TokenPrices[item] and not C.Prototype then
   local level=p.Enchants[item]; local cap=if item=="Skin" or item=="Pet" then 1 else 5
   local cost=C.TokenPrices[item]*(level+1)
   if level&gt;=cap or p.Tokens&lt;cost then return false end
   p.Tokens-=cost; p.Enchants[item]+=1
  else return false end
  return true
 end,true)
 if ok then S.A.once(player,"FirstUpgrade") end; return ok
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">WorldArt</string>
          <ProtectedString name="Source">--!strict
-- Original faceted environment kit. No external asset IDs, plugins, or MeshService needed.
local Tags=game:GetService("CollectionService")
local A: any={}
local P={Sand=Color3.fromRGB(216,194,151),Light=Color3.fromRGB(235,217,176),Stone=Color3.fromRGB(125,143,137),
 Dark=Color3.fromRGB(47,68,69),Teal=Color3.fromRGB(52,119,112),Timber=Color3.fromRGB(132,91,61),
 Copper=Color3.fromRGB(198,115,66),Mint=Color3.fromRGB(110,195,143),Gold=Color3.fromRGB(231,181,74),White=Color3.fromRGB(248,240,214)}
local function model(parent: Instance,name: string): Model local m=Instance.new("Model"); m.Name=name; m.Parent=parent; return m end
local function part(parent: Instance,name: string,size: Vector3,cf: CFrame,color: Color3,shape: string?,collide: boolean?): BasePart
 local p=Instance.new(if shape=="Wedge" then "WedgePart" else "Part") :: BasePart
 p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color; p.Anchored=true; p.Material=Enum.Material.SmoothPlastic
 p.CanCollide=collide~=false; p.CanTouch=false; p.CanQuery=collide~=false
 if p:IsA("Part") then p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; if shape=="Cylinder" then p.Shape=Enum.PartType.Cylinder end end
 p.Parent=parent; return p
end
local function sign(parent: Instance,name: string,cf: CFrame,size: Vector3,heading: string,sub: string,color: Color3?)
 local board=part(parent,name,size,cf,color or P.Dark,nil,false)
 local surface=Instance.new("SurfaceGui"); surface.Name="Lettering"; surface.Face=Enum.NormalId.Front; surface.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud; surface.PixelsPerStud=45; surface.LightInfluence=0; surface.Parent=board
 local text=Instance.new("TextLabel"); text.BackgroundTransparency=1; text.Size=UDim2.fromScale(.92,.55); text.Position=UDim2.fromScale(.04,.08); text.Font=Enum.Font.GothamBold; text.TextScaled=true; text.TextColor3=P.White; text.Text=heading; text.Parent=surface
 local small=text:Clone(); small.Position=UDim2.fromScale(.04,.65); small.Size=UDim2.fromScale(.92,.24); small.Font=Enum.Font.GothamMedium; small.Text=sub; small.TextColor3=P.Mint; small.Parent=surface
 return board
end
local function rock(parent: Instance,cf: CFrame,scale: number,color: Color3)
 local group=model(parent,"FacetedRock")
 part(group,"Core",Vector3.new(2.4,1.9,2.1)*scale,cf*CFrame.Angles(.12,.2,.1),color,"Wedge",false)
 part(group,"Facet",Vector3.new(1.6,1.4,1.8)*scale,cf*CFrame.new(.8*scale,.1*scale,.1*scale)*CFrame.Angles(.1,2.4,.15),color:Lerp(P.Light,.15),"Wedge",false)
 return group
end
local function tree(parent: Instance,cf: CFrame)
 local group=model(parent,"QuarryTree")
 part(group,"Trunk",Vector3.new(.8,5,.8),cf*CFrame.new(0,2.5,0),P.Timber,nil,false)
 for i=0,3 do
  part(group,"LeafFacet",Vector3.new(3.5,3,3.5),cf*CFrame.new(math.cos(i*math.pi/2)*.7,5.1+(i%2)*.7,math.sin(i*math.pi/2)*.7)*CFrame.Angles(0,i*math.pi/2,0),P.Mint:Lerp(P.Teal,i*.13),"Wedge",false)
 end
end
local function crate(parent: Instance,cf: CFrame,scale: number?)
 local s=scale or 1; local group=model(parent,"SupplyCrate")
 part(group,"Box",Vector3.one*2.3*s,cf,P.Timber,nil,false)
 for _,y in {-1,1} do part(group,"Rim",Vector3.new(2.5,.22,2.5)*s,cf*CFrame.new(0,y*s,0),P.Light,nil,false) end
 part(group,"Brace",Vector3.new(.25,2.6,.15)*s,cf*CFrame.new(0,0,-1.18*s)*CFrame.Angles(0,0,.7),P.Dark,nil,false)
end
local function lamp(parent: Instance,cf: CFrame)
 part(parent,"LampPost",Vector3.new(.3,6,.3),cf*CFrame.new(0,3,0),P.Dark,nil,false)
 part(parent,"LanternFrame",Vector3.new(1,1.1,1),cf*CFrame.new(0,6,0),P.Dark,nil,false)
 local bulb=part(parent,"Lamp",Vector3.new(.72,.7,.72),cf*CFrame.new(0,6.05,-.1),P.Gold,nil,false); bulb.Material=Enum.Material.Neon
 -- No per-lamp shadow lights; warm emissive details remain cheap on mobile.
end
local function roof(parent: Instance,cf: CFrame,width: number,depth: number,color: Color3)
 part(parent,"RoofLeft",Vector3.new(width/2+1,.35,depth),cf*CFrame.new(-width/4,0,0)*CFrame.Angles(0,0,.2),color,nil,false)
 part(parent,"RoofRight",Vector3.new(width/2+1,.35,depth),cf*CFrame.new(width/4,0,0)*CFrame.Angles(0,0,-.2),color:Lerp(P.Dark,.15),nil,false)
 part(parent,"RoofRidge",Vector3.new(.55,.4,depth+.1),cf*CFrame.new(0,width*.05,0),color,nil,false)
end
local function stall(parent: Instance,cf: CFrame,title: string,subtitle: string,color: Color3): Model
 local group=model(parent,title.."Stall")
 part(group,"Counter",Vector3.new(9,3.2,4),cf*CFrame.new(0,1.6,0),P.Timber,nil,true)
 part(group,"Countertop",Vector3.new(9.5,.45,4.5),cf*CFrame.new(0,3.4,0),P.Light,nil,true)
 for _,x in {-4.4,4.4} do part(group,"Upright",Vector3.new(.45,7,.45),cf*CFrame.new(x,3.5,.8),P.Timber,nil,false) end
 roof(group,cf*CFrame.new(0,7.3,0),10,6,color)
 sign(group,"ShopSign",cf*CFrame.new(0,5.35,-1.2),Vector3.new(7.6,1.9,.25),title,subtitle)
 for _,x in {-3,-1,1,3} do part(group,"CounterPanel",Vector3.new(.12,2.4,.1),cf*CFrame.new(x,1.6,-2.06),P.Light,nil,false) end
 return group
end
local function tower(parent: Instance,cf: CFrame)
 local group=model(parent,"GuardTower")
 for _,x in {-2.2,2.2} do for _,z in {-2.2,2.2} do part(group,"Support",Vector3.new(.65,11,.65),cf*CFrame.new(x,5.5,z),P.Timber,nil,false) end end
 part(group,"Cabin",Vector3.new(6,3.2,6),cf*CFrame.new(0,11,0),P.Light,nil,false)
 for _,x in {-1.5,1.5} do part(group,"Window",Vector3.new(1.7,1.5,.12),cf*CFrame.new(x,11.3,-3.08),P.Teal,nil,false) end
 part(group,"Deck",Vector3.new(7,.45,7),cf*CFrame.new(0,9.3,0),P.Dark,nil,false)
 roof(group,cf*CFrame.new(0,13.2,0),8,8,P.Teal)
end
local function guard(parent: Instance,cf: CFrame)
 local m=model(parent,"WardenMilo")
 for _,x in {-.45,.45} do
  part(m,"Boot",Vector3.new(.72,.45,1),cf*CFrame.new(x,.24,-.1),P.Dark,nil,false)
  part(m,"Trouser",Vector3.new(.68,1.45,.68),cf*CFrame.new(x,1.15,0),P.Teal,nil,false)
 end
 part(m,"Uniform",Vector3.new(1.8,1.8,.9),cf*CFrame.new(0,2.7,0),P.Teal,nil,false)
 for _,x in {-1.17,1.17} do
  part(m,"Sleeve",Vector3.new(.55,1.3,.65),cf*CFrame.new(x,2.8,0)*CFrame.Angles(0,0,if x&lt;0 then -.15 else .15),P.Teal,nil,false)
  part(m,"Hand",Vector3.new(.5,.5,.55),cf*CFrame.new(x,1.95,0),Color3.fromRGB(227,181,136),nil,false)
 end
 part(m,"Head",Vector3.new(1.3,1.25,1.15),cf*CFrame.new(0,4.2,0),Color3.fromRGB(227,181,136),nil,false)
 for _,x in {-.25,.25} do part(m,"Eye",Vector3.new(.1,.13,.04),cf*CFrame.new(x,4.3,-.59),P.Dark,nil,false) end
 part(m,"Smile",Vector3.new(.25,.06,.04),cf*CFrame.new(0,3.95,-.59),P.Dark,nil,false)
 part(m,"Cap",Vector3.new(1.5,.45,1.4),cf*CFrame.new(0,4.95,0),P.Dark,nil,false)
 part(m,"Visor",Vector3.new(1.6,.12,.7),cf*CFrame.new(0,4.78,-.65),P.Teal,nil,false)
 part(m,"Badge",Vector3.new(.25,.35,.08),cf*CFrame.new(.45,3,-.5),P.Gold,nil,false)
 sign(m,"Nameplate",cf*CFrame.new(0,6.15,0),Vector3.new(4,1.1,.15),"WARDEN MILO","Small steps. Big rocks.")
end
function A.lighting()
 local lighting=game:GetService("Lighting"); lighting.ClockTime=15; lighting.Brightness=2.3
 lighting.Ambient=Color3.fromRGB(125,137,147); lighting.OutdoorAmbient=Color3.fromRGB(151,155,143)
 lighting.EnvironmentDiffuseScale=.7; lighting.EnvironmentSpecularScale=.35; lighting.ShadowSoftness=.45
 for _,name in {"YardAtmosphere","YardBloom","YardGrade"} do local old=lighting:FindFirstChild(name); if old then old:Destroy() end end
 local air=Instance.new("Atmosphere"); air.Name="YardAtmosphere"; air.Density=.22; air.Offset=.15; air.Color=Color3.fromRGB(231,222,194); air.Decay=Color3.fromRGB(153,170,173); air.Parent=lighting
 local bloom=Instance.new("BloomEffect"); bloom.Name="YardBloom"; bloom.Intensity=.12; bloom.Size=18; bloom.Threshold=1.8; bloom.Parent=lighting
 local grade=Instance.new("ColorCorrectionEffect"); grade.Name="YardGrade"; grade.Saturation=.08; grade.Contrast=.06; grade.TintColor=Color3.fromRGB(255,247,230); grade.Parent=lighting
end
function A.yard(parent: Instance,x: number,tier: number): any
 local group=model(parent,"Quarry_"..string.char(64+tier))
 local cf=CFrame.new(x,0,0)
 local tint=P.Teal:Lerp(Color3.fromHSV(((tier-1)*.075+.38)%1,.45,.65),.3)
 part(group,"Foundation",Vector3.new(80,2,80),cf*CFrame.new(0,-14,2),P.Stone,nil,true)
 part(group,"FrontPlaza",Vector3.new(76,2,28),cf*CFrame.new(0,-1,27),P.Sand,nil,true)
 part(group,"RearPlaza",Vector3.new(76,2,28),cf*CFrame.new(0,-1,-27),P.Sand,nil,true)
 for _,dx in {-26,26} do part(group,"SideWalk",Vector3.new(24,2,26),cf*CFrame.new(dx,-1,0),P.Sand,nil,true) end
 -- A dark pit liner and staggered stone bands make the mine read as an excavated quarry.
 for _,y in {-3,-7,-11} do
  for _,dx in {-12.8,12.8} do part(group,"PitStone",Vector3.new(1.4,3.8,26),cf*CFrame.new(dx,y,0),P.Stone:Lerp(P.Dark,math.abs(y)/24),nil,true) end
  for _,dz in {-12.8,12.8} do part(group,"PitStone",Vector3.new(24,3.8,1.4),cf*CFrame.new(0,y,dz),P.Stone:Lerp(P.Dark,math.abs(y)/24),nil,true) end
 end
 for _,dx in {-13.7,13.7} do part(group,"TimberRim",Vector3.new(.65,.7,28),cf*CFrame.new(dx,.3,0),P.Timber,nil,true) end
 for _,dz in {-13.7,13.7} do part(group,"TimberRim",Vector3.new(28,.7,.65),cf*CFrame.new(0,.3,dz),P.Timber,nil,true) end
 for i=-5,5 do
  part(group,"SafetyMark",Vector3.new(.9,.05,.65),cf*CFrame.new(i*2.3,.69,13.7)*CFrame.Angles(0,-.45,0),if i%2==0 then P.Gold else P.Dark,nil,false)
 end
 -- Tall entrance with a readable sign behind the excavation, facing the spawn.
 for _,dx in {-14.7,14.7} do
  part(group,"EntrancePost",Vector3.new(1.3,10,1.3),cf*CFrame.new(dx,5,-15.4),P.Timber,nil,true)
  part(group,"Footing",Vector3.new(2.2,1.2,2.2),cf*CFrame.new(dx,.6,-15.4),P.Stone,nil,true)
 end
 part(group,"EntranceBeam",Vector3.new(32,1.3,1.4),cf*CFrame.new(0,10,-15.4),P.Timber,nil,false)
 sign(group,"MineSign",cf*CFrame.new(0,9,-14.5)*CFrame.Angles(0,math.pi,0),Vector3.new(12,2.8,.35),"QUARRY "..string.char(64+tier),"MINE • SELL • MOVE UP",tint)
 for _,dx in {-34,34} do
  part(group,"BoundaryWall",Vector3.new(2,7,67),cf*CFrame.new(dx,3.5,-1),P.Light,nil,true)
  part(group,"WallCap",Vector3.new(2.8,.6,67),cf*CFrame.new(dx,7,-1),tint,nil,false)
 end
 part(group,"BackWall",Vector3.new(67,7,2),cf*CFrame.new(0,3.5,-34),P.Light,nil,true)
 part(group,"BackCap",Vector3.new(68,.6,2.8),cf*CFrame.new(0,7,-34),tint,nil,false)
 for _,dx in {-22,-11,0,11,22} do
  part(group,"CellWindow",Vector3.new(5,2.8,.1),cf*CFrame.new(dx,4.4,-32.95),P.Dark,nil,false)
  for j=-1,1 do part(group,"WindowBar",Vector3.new(.12,2.9,.18),cf*CFrame.new(dx+j*1.25,4.4,-32.8),P.Stone,nil,false) end
 end
 tower(group,cf*CFrame.new(-30,0,-29))
 -- Faceted outcrops create a quarry silhouette without importing heavy meshes.
 for i=1,6 do
  rock(group,cf*CFrame.new(-30+i*9,-2,-40)*CFrame.Angles(0,i*.8,0),3+(i%3)*1.1,P.Stone:Lerp(P.Teal,.18))
 end
 for _,dx in {-27,27} do tree(group,cf*CFrame.new(dx,0,-15)) end
 for _,dx in {-15,15} do
  local planter=model(group,"YardPlanter")
  part(planter,"Planter",Vector3.new(4,.9,2),cf*CFrame.new(dx,.45,37),P.Copper,nil,false)
  for j=-1,1 do part(planter,"Shrub",Vector3.new(1.3,1.2,1.5),cf*CFrame.new(dx+j,1.3,37)*CFrame.Angles(0,j*.8,0),P.Mint,"Wedge",false) end
 end

 -- Front plaza: separate sell stall and workshop with unobstructed routes.
 local sellStall=stall(group,cf*CFrame.new(-20,0,30),"ORE EXCHANGE","SELL YOUR HAUL",P.Mint)
 local sell=part(group,"SellZone",Vector3.new(10,.15,7),cf*CFrame.new(-20,.09,23),P.Mint,nil,false)
 Tags:AddTag(sell,"SellZone")
 local prompt=Instance.new("ProximityPrompt"); prompt.Name="SellPrompt"; prompt.ActionText="Sell all ore"; prompt.ObjectText="Ore Exchange"; prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.MaxActivationDistance=10; prompt.RequiresLineOfSight=false; prompt.Parent=sell
 local shop=stall(group,cf*CFrame.new(20,0,30),"THE WORKSHOP","BETTER GEAR. BIGGER HAULS.",tint)
 local anvil=part(shop,"Anvil",Vector3.new(2,.65,1.3),cf*CFrame.new(20,3.9,30),P.Dark,nil,false)
 part(shop,"AnvilTop",Vector3.new(3,.4,1.5),anvil.CFrame*CFrame.new(0,.4,0),P.Stone,nil,false)
 local workshopPrompt=Instance.new("ProximityPrompt"); workshopPrompt.Name="WorkshopPrompt"; workshopPrompt.ActionText="Upgrade gear"; workshopPrompt.ObjectText="The Workshop"; workshopPrompt.KeyboardKeyCode=Enum.KeyCode.E; workshopPrompt.MaxActivationDistance=10; workshopPrompt.RequiresLineOfSight=false; workshopPrompt.Parent=anvil
 crate(group,cf*CFrame.new(-28,1.2,21)*CFrame.Angles(0,.2,0))
 crate(group,cf*CFrame.new(28,1.2,23)*CFrame.Angles(0,-.3,0),.8)
 local cart=model(group,"OreCart")
 part(cart,"Hopper",Vector3.new(3.3,1.8,2.4),cf*CFrame.new(24,1.8,15),P.Dark,nil,false)
 part(cart,"HopperLip",Vector3.new(3.6,.25,2.7),cf*CFrame.new(24,2.8,15),tint,nil,false)
 for _,dx in {-1.2,1.2} do for _,dz in {-1.1,1.1} do part(cart,"Wheel",Vector3.new(.4,.9,.9),cf*CFrame.new(24+dx,.6,15+dz),P.Timber,"Cylinder",false) end end
 rock(cart,cf*CFrame.new(24,3,15),.6,P.Copper)
 for i=1,5 do
  local side=if i%2==0 then -1 else 1
  rock(group,cf*CFrame.new(side*28,.8,-20+i*6)*CFrame.Angles(0,i,0),.6+(i%3)*.25,P.Stone)
 end
 for _,dx in {-29,29} do lamp(group,cf*CFrame.new(dx,0,5)) end
 for _,dx in {-19,19} do
  part(group,"BenchSeat",Vector3.new(6,.4,1.6),cf*CFrame.new(dx,1.5,-24),P.Timber,nil,false)
  for _,leg in {-2,2} do part(group,"BenchLeg",Vector3.new(.4,1.5,1.5),cf*CFrame.new(dx+leg,.75,-24),P.Dark,nil,false) end
 end
 guard(group,cf*CFrame.new(8,0,30))
 -- Shallow stair on the front of the plaza; a clean sightline faces the mine.
 for i=1,3 do part(group,"WelcomePaver",Vector3.new(6,.07,2.4),cf*CFrame.new(0,.06,18+i*5),P.Light,nil,false) end
 local region=part(group,"MineRegion",Vector3.new(24,12,24),cf*CFrame.new(0,-6,0),P.Dark,nil,false)
 region.Transparency=1; region:SetAttribute("Tier",tier); Tags:AddTag(region,"MineRegion")
 if tier==1 then
  local spawn=Instance.new("SpawnLocation"); spawn.Name="YardSpawn"; spawn.Size=Vector3.new(6,.2,6); spawn.Position=Vector3.new(x,.1,24); spawn.Anchored=true; spawn.Neutral=true; spawn.Transparency=1; spawn.CanCollide=false; spawn.Duration=0; spawn.Parent=group
  part(group,"VIPPlinth",Vector3.new(18,14,18),CFrame.new(-50,-7,25),P.Stone,nil,true)
  part(group,"VIPDeck",Vector3.new(18,.4,18),CFrame.new(-50,.2,25),P.Timber,nil,true)
  for _,dx in {-57,-43} do for _,dz in {18,32} do part(group,"LoungePost",Vector3.new(.55,7,.55),CFrame.new(dx,3.5,dz),P.Timber,nil,false) end end
  roof(group,CFrame.new(-50,7.3,25),19,19,P.Teal)
  sign(group,"VIPSign",CFrame.new(-50,3,31),Vector3.new(9,2,.4),"THE QUIET CORNER","VIP LOUNGE",P.Teal)
 end
 return {Sell=sell,Prompt=prompt}
end
function A.ore(block: BasePart,index: number,tier: number)
 block.Material=if index==1 then Enum.Material.Sandstone else Enum.Material.Slate
 local shade=Color3.fromHSV(((tier-1)*.075+.38)%1,.25,.65)
 if tier&gt;1 then block.Color=block.Color:Lerp(shade,.15) end
 if index==1 then return end
 local tint=if index==2 then P.Copper else P.Mint
 local ore=part(block,"OreVein",Vector3.new(1.1,.45,1.5),block.CFrame*CFrame.new(.45,block.Size.Y/2+.1,.15)*CFrame.Angles(0,.55,0),tint,"Wedge",false)
 if index==3 then
  ore.Material=Enum.Material.Neon
  part(block,"CrystalFacet",Vector3.new(.7,.8,.8),block.CFrame*CFrame.new(-.6,block.Size.Y/2+.2,-.5)*CFrame.Angles(.15,-.35,.15),P.Mint,"Wedge",false)
 end
end
function A.pickaxe(tool: Tool)
 local handle=part(tool,"Handle",Vector3.new(.32,3.1,.38),CFrame.new(),P.Timber,nil,false)
 local function attach(name: string,size: Vector3,cf: CFrame,color: Color3,shape: string?)
  local p=part(tool,name,size,cf,color,shape,false); p.Anchored=false; p.Massless=true
  local weld=Instance.new("WeldConstraint"); weld.Part0=handle; weld.Part1=p; weld.Parent=p; return p
 end
 handle.Anchored=false; handle.Massless=true
 attach("Blade",Vector3.new(2.4,.5,.6),CFrame.new(0,1.1,0),P.Stone)
 attach("LeftTip",Vector3.new(.8,.65,.6),CFrame.new(-1.45,.99,0)*CFrame.Angles(0,0,.4),P.Stone,"Wedge")
 attach("RightTip",Vector3.new(.8,.65,.6),CFrame.new(1.45,.99,0)*CFrame.Angles(0,math.pi,-.4),P.Stone,"Wedge")
 for _,y in {-.9,-.6,-.3} do attach("Grip",Vector3.new(.4,.14,.45),CFrame.new(0,y,0),P.Dark) end
 attach("Collar",Vector3.new(.55,.65,.65),CFrame.new(0,1.1,0),P.Teal)
end
function A.stylePickaxe(tool: Tool,tier: number,gold: boolean)
 local stamp=tostring(tier)..":"..tostring(gold)
 if tool:GetAttribute("ArtStyle")==stamp then return end
 tool:SetAttribute("ArtStyle",stamp)
 local colors={P.Stone,P.Copper,P.Teal,P.Mint}
 for _,name in {"Blade","LeftTip","RightTip"} do
  local p=tool:FindFirstChild(name)
  if p and p:IsA("BasePart") then p.Color=if gold then P.Gold else colors[math.clamp(tier,1,#colors)] end
 end
 local config=require(game.ReplicatedStorage.Shared.Config)
 tool.Name=config.Picks[tier].Name
end
return A
</ProtectedString>
